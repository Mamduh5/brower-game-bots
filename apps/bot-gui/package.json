{
  "name": "@game-bots/bot-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "dev": "pnpm -w build && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2",
    "sql.js": "^1.13.0",
    "@game-bots/agent-player": "workspace:*",
    "@game-bots/environment-windows": "workspace:*",
    "@game-bots/game-sdk": "workspace:*",
    "@game-bots/artifact-store-fs": "workspace:*",
    "@game-bots/environment-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/sql.js": "^1.4.9"
  }
}
